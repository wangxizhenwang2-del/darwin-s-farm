    - id: 3_4
      title: "\u73AF\u5883\u4E0E\u751F\u547D"
      content: "\u73AF\u5883\u53D8\u5316\u65E2\u4F1A\u5F71\u54CD\u751F\u7269\u7684\u751F\u5B58\uFF0C\u4E5F\u53EF\u80FD<color=#2F6148><b>\u5F15\u5BFC\u6027\u72B6\u53D8\u5316</b></color>\u3002\n\u4F8B\u5982\uFF0C\u98DF\u7269\u5145\u8DB3\u53EF\u80FD\u6709\u5229\u4E8E\u66F4\u5927\u7684\u4F53\u578B\uFF1B<color=#2F6148><b>\u957F\u671F\u7A33\u5B9A\u7684\u98DF\u7269\u4F9B\u5E94</b></color>\u53EF\u80FD\u6709\u5229\u4E8E\u7E41\u6B96\uFF1B\u5BD2\u51B7\u5219\u53EF\u80FD\u8BA9\u79CD\u7FA4\u9010\u6E10\u9002\u5E94\u4F4E\u6E29\u3002\n<color=#2F6148><b>\u4F60\u6539\u53D8\u7684\u662F\u73AF\u5883\uFF0C\u800C\u4E0D\u662F\u76F4\u63A5\u4FEE\u6539\u751F\u7269\u3002</b></color>"
      mobileContent: "\u73AF\u5883\u53D8\u5316\u65E2\u4F1A\u5F71\u54CD\u751F\u7269\u7684\u751F\u5B58\uFF0C\u4E5F\u53EF\u80FD<color=#2F6148><b>\u5F15\u5BFC\u6027\u72B6\u53D8\u5316</b></color>\u3002\n\u4F8B\u5982\uFF0C\u98DF\u7269\u5145\u8DB3\u53EF\u80FD\u6709\u5229\u4E8E\u66F4\u5927\u7684\u4F53\u578B\uFF1B<color=#2F6148><b>\u957F\u671F\u7A33\u5B9A\u7684\u98DF\u7269\u4F9B\u5E94</b></color>\u53EF\u80FD\u6709\u5229\u4E8E\u7E41\u6B96\uFF1B\u5BD2\u51B7\u5219\u53EF\u80FD\u8BA9\u79CD\u7FA4\u9010\u6E10\u9002\u5E94\u4F4E\u6E29\u3002\n<color=#2F6148><b>\u4F60\u6539\u53D8\u7684\u662F\u73AF\u5883\uFF0C\u800C\u4E0D\u662F\u76F4\u63A5\u4FEE\u6539\u751F\u7269\u3002</b></color>"
      illustration: {fileID: 0}
      sortOrder: 3
  - id: chapter4
    title: "\u8BA4\u8BC6\u751F\u547D"
    sortOrder: 3
    pages:
    - id: 4_1
      title: "\u8BA4\u8BC6\u751F\u7269"
      content: "\u519C\u573A\u4E2D\u751F\u6D3B\u7740\u5404\u79CD\u751F\u7269\uFF0C\u6BCF\u79CD\u751F\u7269\u90FD\u6709\u81EA\u5DF1\u7684\u4E60\u6027\u548C\u751F\u5B58\u9700\u6C42\u3002\n\u6309\u4F4F
        <color=#914B2D><b>Alt</b></color> \u5E76\u7528<color=#914B2D><b>\u9F20\u6807\u5DE6\u952E\u5355\u51FB\u5730\u5757\u4E0A\u7684\u751F\u7269</b></color>\uFF0C\u53EF\u4EE5\u67E5\u770B\u8BE6\u7EC6\u4FE1\u606F\uFF0C\u5305\u62EC<color=#2F6148><b>\u79CD\u7FA4\u6570\u91CF</b></color>\u3001<color=#2F6148><b>\u6027\u72B6</b></color>\u548C<color=#2F6148><b>\u751F\u5B58\u72B6\u6001</b></color>\u3002\n\u6E38\u620F\u4E3B\u8981\u6A21\u62DF<color=#2F6148><b>\u79CD\u7FA4</b></color>\uFF0C<color=#2F6148><b>\u800C\u975E\u9010\u53EA\u6A21\u62DF\u52A8\u7269</b></color>\u3002"
      mobileContent: "\u519C\u573A\u4E2D\u751F\u6D3B\u7740\u5404\u79CD\u751F\u7269\uFF0C\u6BCF\u79CD\u751F\u7269\u90FD\u6709\u81EA\u5DF1\u7684\u4E60\u6027\u548C\u751F\u5B58\u9700\u6C42\u3002\n<color=#914B2D><b>\u8F7B\u70B9\u5730\u5757\u4E0A\u7684\u751F\u7269</b></color>\uFF0C\u53EF\u4EE5\u67E5\u770B\u8BE6\u7EC6\u4FE1\u606F\uFF0C\u5305\u62EC<color=#2F6148><b>\u79CD\u7FA4\u6570\u91CF</b></color>\u3001<color=#2F6148><b>\u6027\u72B6</b></color>\u548C<color=#2F6148><b>\u751F\u5B58\u72B6\u6001</b></color>\u3002\n\u6E38\u620F\u4E3B\u8981\u6A21\u62DF<color=#2F6148><b>\u79CD\u7FA4</b></color>\uFF0C<color=#2F6148><b>\u800C\u975E\u9010\u53EA\u6A21\u62DF\u52A8\u7269</b></color>\u3002"
      illustration: {fileID: 0}
      sortOrder: 0
    - id: 4_2
      title: "\u4E94\u9879\u6027\u72B6"
      content: "\u6027\u72B6 \xB7 \u4F5C\u7528\n<color=#2F6148><b>\u9002\u6E29</b></color>
        \xB7 \u6700\u9002\u5E94\u7684\u6E29\u5EA6\n<color=#2F6148><b>\u9002\u6E7F</b></color>
        \xB7 \u6700\u9002\u5E94\u7684\u6E7F\u5EA6\n<color=#2F6148><b>\u8FD0\u52A8</b></color>
        \xB7 \u6D3B\u52A8\u4E0E\u8FC1\u5F99\u80FD\u529B\n<color=#2F6148><b>\u4F53\u578B</b></color>
        \xB7 \u5F71\u54CD\u98DF\u7269\u6D88\u8017\u548C\u751F\u5B58\u65B9\u5F0F\n<color=#2F6148><b>\u7E41\u6B96</b></color>
        \xB7 \u5F71\u54CD\u79CD\u7FA4\u4EA7\u751F\u540E\u4EE3\u7684\u80FD\u529B\n\u6027\u72B6\u53EF\u80FD<color=#2F6148><b>\u968F\u73AF\u5883\u548C\u65F6\u95F4\u53D8\u5316</b></color>\u3002"
      mobileContent: "\u6027\u72B6 \xB7 \u4F5C\u7528\n<color=#2F6148><b>\u9002\u6E29</b></color>
        \xB7 \u6700\u9002\u5E94\u7684\u6E29\u5EA6\n<color=#2F6148><b>\u9002\u6E7F</b></color>
        \xB7 \u6700\u9002\u5E94\u7684\u6E7F\u5EA6\n<color=#2F6148><b>\u8FD0\u52A8</b></color>
        \xB7 \u6D3B\u52A8\u4E0E\u8FC1\u5F99\u80FD\u529B\n<color=#2F6148><b>\u4F53\u578B</b></color>
        \xB7 \u5F71\u54CD\u98DF\u7269\u6D88\u8017\u548C\u751F\u5B58\u65B9\u5F0F\n<color=#2F6148><b>\u7E41\u6B96</b></color>
        \xB7 \u5F71\u54CD\u79CD\u7FA4\u4EA7\u751F\u540E\u4EE3\u7684\u80FD\u529B\n\u6027\u72B6\u53EF\u80FD<color=#2F6148><b>\u968F\u73AF\u5883\u548C\u65F6\u95F4\u53D8\u5316</b></color>\u3002"
      illustration: {fileID: 21300000, guid: 0d6ff5c370fa4b1c81d47e16b7d4cfb5, type: 3}
      sortOrder: 1
    - id: 4_3
      title: "\u751F\u7269\u7F51\u4E0E\u8FDB\u5316\u7F51"
      content: "\u6309 <color=#914B2D><b>M</b></color> \u6253\u5F00<color=#2F6148><b>\u751F\u7269\u7F51</b></color>\u4E0E<color=#2F6148><b>\u8FDB\u5316\u7F51</b></color>\u3002\n-
        <color=#2F6148><b>\u751F\u7269\u7F51</b></color>\uFF1A\u67E5\u770B\u4E0D\u540C\u751F\u7269\u4E4B\u95F4\u7684<color=#2F6148><b>\u751F\u6001\u5173\u7CFB</b></color>\u3002\n-
        <color=#2F6148><b>\u8FDB\u5316\u7F51</b></color>\uFF1A\u67E5\u770B\u53EF\u80FD\u7684<color=#2F6148><b>\u8FDB\u5316\u8DEF\u7EBF</b></color>\u3002\n\u5728<color=#2F6148><b>\u751F\u7269\u7F51</b></color>\u4E2D<color=#914B2D><b>\u5DE6\u952E\u70B9\u51FB\u67D0\u79CD\u751F\u7269</b></color>\uFF0C\u53EF\u4EE5\u67E5\u770B\u5B83\u7684\u4FE1\u606F\u4E0E<color=#2F6148><b>\u8FDB\u5316\u9700\u6C42</b></color>\u3002\u4F8B\u5982\uFF0C\u9700\u6C42\u63D0\u793A\u53EF\u80FD\u51FA\u73B0\uFF1A\u6E29\u5EA6
        ++\u3001\u6E7F\u5EA6 - \u7B49\u3002\n+ \u8868\u793A<color=#2F6148><b>\u63D0\u9AD8</b></color>\uFF0C-
        \u8868\u793A<color=#2F6148><b>\u964D\u4F4E</b></color>\uFF0C\u7EA6\u7B49\u4E8E
        \u8868\u793A<color=#2F6148><b>\u63A5\u8FD1\u76EE\u6807</b></color>\uFF1B\u91CD\u590D\u7B26\u53F7\u8868\u793A\u9700\u8981<color=#2F6148><b>\u66F4\u5927\u5E45\u5EA6\u8C03\u6574</b></color>\u3002"
      mobileContent: "\u70b9\u51fb\u5c4f\u5e55\u53f3\u4fa7\u7684<color=#914B2D><b>\u300c\u8fdb\u5316\u7f51\u300d</b></color>\u6309\u94ae\u6253\u5f00\u5730\u56fe\uff0c\u518d\u70b9\u5730\u56fe\u5185\u7684<color=#914B2D><b>\u5207\u6362\u6309\u94ae</b></color>\uff0c\u5728<color=#2F6148><b>\u751f\u7269\u7f51</b></color>\u4e0e<color=#2F6148><b>\u8fdb\u5316\u7f51</b></color>\u4e4b\u95f4\u5207\u6362\u3002\n- <color=#2F6148><b>\u751f\u7269\u7f51</b></color>\uff1a\u67e5\u770b\u4e0d\u540c\u751f\u7269\u4e4b\u95f4\u7684\u751f\u6001\u5173\u7cfb\u3002\n- <color=#2F6148><b>\u8fdb\u5316\u7f51</b></color>\uff1a\u67e5\u770b\u53ef\u80fd\u7684\u8fdb\u5316\u8def\u7ebf\u3002\n\u5728\u5730\u56fe\u7a7a\u767d\u5904<color=#914B2D><b>\u5355\u6307\u62d6\u52a8</b></color>\u53ef\u5e73\u79fb\uff0c<color=#914B2D><b>\u53cc\u6307\u5f20\u5408</b></color>\u53ef\u7f29\u653e\u3002<color=#914B2D><b>\u8f7b\u70b9\u751f\u7269\u8282\u70b9</b></color>\uff0c\u67e5\u770b\u5b83\u7684\u4fe1\u606f\u4e0e\u8fdb\u5316\u9700\u6c42\u3002\n\u9700\u6c42\u63d0\u793a\u53ef\u80fd\u51fa\u73b0\u6e29\u5ea6 ++\u3001\u6e7f\u5ea6 - \u7b49\uff1a+ \u8868\u793a\u63d0\u9ad8\uff0c- \u8868\u793a\u964d\u4f4e\uff0c\u7ea6\u7b49\u4e8e\u8868\u793a\u63a5\u8fd1\u76ee\u6807\uff1b\u91cd\u590d\u7b26\u53f7\u8868\u793a\u9700\u8981\u66f4\u5927\u5e45\u5ea6\u8c03\u6574\u3002"
      illustration: {fileID: 21300000, guid: 667578e34c2c4cda97e547673bc1ff96, type: 3}
      sortOrder: 2
    - id: 4_4
      title: "\u89C2\u5BDF\u751F\u7269\u7684\u53D8\u5316"
      content: "\u751F\u7269<color=#2F6148><b>\u4E0D\u4F1A\u56E0\u4E3A\u4E00\u6B21\u73AF\u5883\u64CD\u4F5C\u5C31\u7ACB\u523B\u8FDB\u5316</b></color>\u3002\n\u89C2\u5BDF<color=#2F6148><b>\u4E94\u9879\u6027\u72B6</b></color>\u3001<color=#2F6148><b>\u79CD\u7FA4\u6570\u91CF</b></color>\u548C<color=#2F6148><b>\u8FDB\u5316\u9700\u6C42</b></color>\uFF0C\u5224\u65AD\u8C03\u6574\u662F\u5426\u6709\u6548\u3002\n<color=#2F6148><b>\u89C2\u5BDF\u7B14\u8BB0</b></color>\uFF1A\u60F3\u57F9\u80B2\u65B0\u7269\u79CD\uFF1F\u5148\u5728\u8FDB\u5316\u7F51\u4E2D<color=#2F6148><b>\u627E\u5230\u76EE\u6807</b></color>\uFF0C\u518D\u5C1D\u8BD5\u521B\u9020\u5B83\u9700\u8981\u7684\u73AF\u5883\u3002"
      mobileContent: "\u751F\u7269<color=#2F6148><b>\u4E0D\u4F1A\u56E0\u4E3A\u4E00\u6B21\u73AF\u5883\u64CD\u4F5C\u5C31\u7ACB\u523B\u8FDB\u5316</b></color>\u3002\n\u89C2\u5BDF<color=#2F6148><b>\u4E94\u9879\u6027\u72B6</b></color>\u3001<color=#2F6148><b>\u79CD\u7FA4\u6570\u91CF</b></color>\u548C<color=#2F6148><b>\u8FDB\u5316\u9700\u6C42</b></color>\uFF0C\u5224\u65AD\u8C03\u6574\u662F\u5426\u6709\u6548\u3002\n<color=#2F6148><b>\u89C2\u5BDF\u7B14\u8BB0</b></color>\uFF1A\u60F3\u57F9\u80B2\u65B0\u7269\u79CD\uFF1F\u5148\u5728\u8FDB\u5316\u7F51\u4E2D<color=#2F6148><b>\u627E\u5230\u76EE\u6807</b></color>\uFF0C\u518D\u5C1D\u8BD5\u521B\u9020\u5B83\u9700\u8981\u7684\u73AF\u5883\u3002"
      illustration: {fileID: 0}
      sortOrder: 3
  - id: chapter5
    title: "\u751F\u6001\u4E0E\u6F14\u5316"
    sortOrder: 4
    pages:
    - id: 5_1
      title: "\u98DF\u7269\u4E0E\u751F\u5B58"
      content: "\u6BCF\u4E00\u79CD\u751F\u7269\u90FD\u9700\u8981\u98DF\u7269\u624D\u80FD\u751F\u5B58\u548C\u7E41\u6B96\u3002\n\u98DF\u8349\u751F\u7269\u4F9D\u9760<color=#2F6148><b>\u690D\u7269\u8D44\u6E90</b></color>\uFF0C\u98DF\u8089\u751F\u7269\u5219\u9700\u8981<color=#2F6148><b>\u6355\u98DF\u5176\u4ED6\u52A8\u7269</b></color>\u3002\n<color=#2F6148><b>\u98DF\u7269\u5145\u8DB3</b></color>\u65F6\u79CD\u7FA4\u53EF\u80FD\u58EE\u5927\uFF1B<color=#2F6148><b>\u98DF\u7269\u4E0D\u8DB3</b></color>\u65F6\uFF0C\u79CD\u7FA4\u53EF\u80FD\u4E0B\u964D\u751A\u81F3<color=#2F6148><b>\u706D\u7EDD</b></color>\u3002"
      mobileContent: "\u6BCF\u4E00\u79CD\u751F\u7269\u90FD\u9700\u8981\u98DF\u7269\u624D\u80FD\u751F\u5B58\u548C\u7E41\u6B96\u3002\n\u98DF\u8349\u751F\u7269\u4F9D\u9760<color=#2F6148><b>\u690D\u7269\u8D44\u6E90</b></color>\uFF0C\u98DF\u8089\u751F\u7269\u5219\u9700\u8981<color=#2F6148><b>\u6355\u98DF\u5176\u4ED6\u52A8\u7269</b></color>\u3002\n<color=#2F6148><b>\u98DF\u7269\u5145\u8DB3</b></color>\u65F6\u79CD\u7FA4\u53EF\u80FD\u58EE\u5927\uFF1B<color=#2F6148><b>\u98DF\u7269\u4E0D\u8DB3</b></color>\u65F6\uFF0C\u79CD\u7FA4\u53EF\u80FD\u4E0B\u964D\u751A\u81F3<color=#2F6148><b>\u706D\u7EDD</b></color>\u3002"
      illustration: {fileID: 21300000, guid: 667578e34c2c4cda97e547673bc1ff96, type: 3}
      sortOrder: 0
    - id: 5_2
      title: "\u7ADE\u4E89\u4E0E\u6355\u98DF"
      content: "\u540C\u4E00\u5757\u571F\u5730\u4E0A\u7684\u751F\u7269\u4F1A\u76F8\u4E92\u5F71\u54CD\u3002\n\u591A\u4E2A\u79CD\u7FA4\u53EF\u80FD<color=#2F6148><b>\u4E89\u593A\u540C\u4E00\u4EFD\u98DF\u7269</b></color>\uFF0C<color=#2F6148><b>\u6355\u98DF\u8005</b></color>\u4E5F\u4F1A\u5F71\u54CD<color=#2F6148><b>\u730E\u7269\u6570\u91CF</b></color>\u3002\n\u4E00\u4E2A\u79CD\u7FA4\u7684\u53D8\u5316\uFF0C\u53EF\u80FD\u5F71\u54CD\u6574\u5757\u571F\u5730\u7684<color=#2F6148><b>\u751F\u6001\u5E73\u8861</b></color>\u3002"
      mobileContent: "\u540C\u4E00\u5757\u571F\u5730\u4E0A\u7684\u751F\u7269\u4F1A\u76F8\u4E92\u5F71\u54CD\u3002\n\u591A\u4E2A\u79CD\u7FA4\u53EF\u80FD<color=#2F6148><b>\u4E89\u593A\u540C\u4E00\u4EFD\u98DF\u7269</b></color>\uFF0C<color=#2F6148><b>\u6355\u98DF\u8005</b></color>\u4E5F\u4F1A\u5F71\u54CD<color=#2F6148><b>\u730E\u7269\u6570\u91CF</b></color>\u3002\n\u4E00\u4E2A\u79CD\u7FA4\u7684\u53D8\u5316\uFF0C\u53EF\u80FD\u5F71\u54CD\u6574\u5757\u571F\u5730\u7684<color=#2F6148><b>\u751F\u6001\u5E73\u8861</b></color>\u3002"
      illustration: {fileID: 21300000, guid: 667578e34c2c4cda97e547673bc1ff96, type: 3}
      sortOrder: 1
    - id: 5_3
      title: "\u8FC1\u5F99\u4E0E\u6269\u6563"
      content: "\u5F53<color=#2F6148><b>\u76F8\u90BB\u5730\u5757</b></color>\u51FA\u73B0\u66F4\u9002\u5B9C\u7684\u751F\u5B58\u73AF\u5883\u65F6\uFF0C\u751F\u7269\u53EF\u80FD\u8FC1\u5F99\u8FC7\u53BB\u3002\n\u8FC1\u5F99\u53D7\u5230<color=#2F6148><b>\u8FD0\u52A8\u80FD\u529B</b></color>\u3001<color=#2F6148><b>\u5730\u5757\u73AF\u5883</b></color>\u4E0E<color=#2F6148><b>\u6D77\u62D4\u8FDE\u901A\u6027</b></color>\u7684\u5F71\u54CD\uFF0C<color=#2F6148><b>\u5E76\u4E0D\u4FDD\u8BC1\u6210\u529F</b></color>\u3002\n<color=#2F6148><b>\u89C2\u5BDF\u7B14\u8BB0</b></color>\uFF1A\u5EFA\u9020\u73AF\u5883\u4E0D\u540C\u7684\u90BB\u5730\uFF0C\u4E5F\u8BB8\u80FD\u4E3A\u751F\u7269\u521B\u9020\u65B0\u7684\u751F\u5B58\u673A\u4F1A\u3002"
      mobileContent: "\u5F53<color=#2F6148><b>\u76F8\u90BB\u5730\u5757</b></color>\u51FA\u73B0\u66F4\u9002\u5B9C\u7684\u751F\u5B58\u73AF\u5883\u65F6\uFF0C\u751F\u7269\u53EF\u80FD\u8FC1\u5F99\u8FC7\u53BB\u3002\n\u8FC1\u5F99\u53D7\u5230<color=#2F6148><b>\u8FD0\u52A8\u80FD\u529B</b></color>\u3001<color=#2F6148><b>\u5730\u5757\u73AF\u5883</b></color>\u4E0E<color=#2F6148><b>\u6D77\u62D4\u8FDE\u901A\u6027</b></color>\u7684\u5F71\u54CD\uFF0C<color=#2F6148><b>\u5E76\u4E0D\u4FDD\u8BC1\u6210\u529F</b></color>\u3002\n<color=#2F6148><b>\u89C2\u5BDF\u7B14\u8BB0</b></color>\uFF1A\u5EFA\u9020\u73AF\u5883\u4E0D\u540C\u7684\u90BB\u5730\uFF0C\u4E5F\u8BB8\u80FD\u4E3A\u751F\u7269\u521B\u9020\u65B0\u7684\u751F\u5B58\u673A\u4F1A\u3002"
      illustration: {fileID: 0}
      sortOrder: 2
    - id: 5_4
      title: "\u9002\u5E94\u4E0E\u53D8\u5F02"
      content: "\u73AF\u5883\u53D8\u5316\u65F6\uFF0C\u751F\u7269\u4E5F\u53EF\u80FD\u9010\u6E10\u6539\u53D8\u81EA\u8EAB\u7684<color=#2F6148><b>\u6027\u72B6</b></color>\uFF0C\u4EE5<color=#2F6148><b>\u9002\u5E94</b></color>\u65B0\u7684\u751F\u5B58\u6761\u4EF6\u3002\n\u4F8B\u5982\uFF0C\u5BD2\u51B7\u53EF\u80FD\u4FC3\u4F7F\u79CD\u7FA4<color=#2F6148><b>\u9002\u5E94</b></color>\u66F4\u4F4E\u6E29\u5EA6\uFF1B\u98DF\u7269\u4F9B\u7ED9\u53D8\u5316\u53EF\u80FD\u5F71\u54CD\u4F53\u578B\u548C\u7E41\u6B96\u3002\n\u8FD9\u4E9B\u5FAE\u5C0F\u7684<color=#2F6148><b>\u6027\u72B6</b></color>\u53D8\u5316\u79F0\u4E3A<color=#2F6148><b>\u53D8\u5F02</b></color>\uFF0C\u4F46\u53D8\u5316<color=#2F6148><b>\u672A\u5FC5\u90FD\u7B26\u5408\u4F60\u7684\u9884\u671F</b></color>\u3002"
      mobileContent: "\u73AF\u5883\u53D8\u5316\u65F6\uFF0C\u751F\u7269\u4E5F\u53EF\u80FD\u9010\u6E10\u6539\u53D8\u81EA\u8EAB\u7684<color=#2F6148><b>\u6027\u72B6</b></color>\uFF0C\u4EE5<color=#2F6148><b>\u9002\u5E94</b></color>\u65B0\u7684\u751F\u5B58\u6761\u4EF6\u3002\n\u4F8B\u5982\uFF0C\u5BD2\u51B7\u53EF\u80FD\u4FC3\u4F7F\u79CD\u7FA4<color=#2F6148><b>\u9002\u5E94</b></color>\u66F4\u4F4E\u6E29\u5EA6\uFF1B\u98DF\u7269\u4F9B\u7ED9\u53D8\u5316\u53EF\u80FD\u5F71\u54CD\u4F53\u578B\u548C\u7E41\u6B96\u3002\n\u8FD9\u4E9B\u5FAE\u5C0F\u7684<color=#2F6148><b>\u6027\u72B6</b></color>\u53D8\u5316\u79F0\u4E3A<color=#2F6148><b>\u53D8\u5F02</b></color>\uFF0C\u4F46\u53D8\u5316<color=#2F6148><b>\u672A\u5FC5\u90FD\u7B26\u5408\u4F60\u7684\u9884\u671F</b></color>\u3002"
      illustration: {fileID: 0}
      sortOrder: 3
    - id: 5_5
      title: "\u53D8\u5F02\u4E0E\u8FDB\u5316"
      content: "\u4E00\u6B21\u53D8\u5F02\u901A\u5E38\u53EA\u5E26\u6765\u5FAE\u5C0F\u53D8\u5316\u3002\n\u5F53\u53D8\u5F02\u4E0D\u65AD\u79EF\u7D2F\uFF0C\u4F7F\u79CD\u7FA4<color=#2F6148><b>\u4E94\u9879\u6027\u72B6\u63A5\u8FD1\u76EE\u6807</b></color>\uFF0C\u5E76\u6301\u7EED\u6EE1\u8DB3<color=#2F6148><b>\u6570\u91CF\u4E0E\u65F6\u95F4\u6761\u4EF6</b></color>\u65F6\uFF0C\u4E00\u90E8\u5206\u539F\u6709\u79CD\u7FA4\u4FBF\u53EF\u80FD<color=#2F6148><b>\u5206\u5316\u6210\u65B0\u7684\u7269\u79CD</b></color>\u3002\n\u65B0\u7269\u79CD\u4ECD\u9700\u8981<color=#2F6148><b>\u98DF\u7269\u4E0E\u751F\u5B58\u7A7A\u95F4</b></color>\uFF0C\u4E5F\u4F1A\u9762\u5BF9\u7ADE\u4E89\u548C\u6355\u98DF\u3002\n<color=#2F6148><b>\u89C2\u5BDF\u7B14\u8BB0</b></color>\uFF1A\u8FDB\u5316\u6765\u81EA\u53D8\u5316\u7684\u79EF\u7D2F\uFF1B\u65B0\u751F\u547D\u8BDE\u751F\u540E\uFF0C\u4E5F\u9700\u8981<color=#2F6148><b>\u751F\u6001\u73AF\u5883\u652F\u6301</b></color>\u5B83\u7EE7\u7EED\u751F\u5B58\u3002"
      mobileContent: "\u4E00\u6B21\u53D8\u5F02\u901A\u5E38\u53EA\u5E26\u6765\u5FAE\u5C0F\u53D8\u5316\u3002\n\u5F53\u53D8\u5F02\u4E0D\u65AD\u79EF\u7D2F\uFF0C\u4F7F\u79CD\u7FA4<color=#2F6148><b>\u4E94\u9879\u6027\u72B6\u63A5\u8FD1\u76EE\u6807</b></color>\uFF0C\u5E76\u6301\u7EED\u6EE1\u8DB3<color=#2F6148><b>\u6570\u91CF\u4E0E\u65F6\u95F4\u6761\u4EF6</b></color>\u65F6\uFF0C\u4E00\u90E8\u5206\u539F\u6709\u79CD\u7FA4\u4FBF\u53EF\u80FD<color=#2F6148><b>\u5206\u5316\u6210\u65B0\u7684\u7269\u79CD</b></color>\u3002\n\u65B0\u7269\u79CD\u4ECD\u9700\u8981<color=#2F6148><b>\u98DF\u7269\u4E0E\u751F\u5B58\u7A7A\u95F4</b></color>\uFF0C\u4E5F\u4F1A\u9762\u5BF9\u7ADE\u4E89\u548C\u6355\u98DF\u3002\n<color=#2F6148><b>\u89C2\u5BDF\u7B14\u8BB0</b></color>\uFF1A\u8FDB\u5316\u6765\u81EA\u53D8\u5316\u7684\u79EF\u7D2F\uFF1B\u65B0\u751F\u547D\u8BDE\u751F\u540E\uFF0C\u4E5F\u9700\u8981<color=#2F6148><b>\u751F\u6001\u73AF\u5883\u652F\u6301</b></color>\u5B83\u7EE7\u7EED\u751F\u5B58\u3002"
      illustration: {fileID: 0}
      sortOrder: 4
  - id: chapter6
    title: "\u5F15\u5BFC\u8FDB\u5316"
    sortOrder: 5
    pages:
    - id: 6_1
      title: "\u9009\u62E9\u8FDB\u5316\u76EE\u6807"
      content: "\u6309 <color=#914B2D><b>M</b></color> \u6253\u5F00\u8FDB\u5316\u7F51\uFF0C\u9009\u62E9\u60F3\u57F9\u80B2\u7684\u7269\u79CD\uFF0C\u67E5\u770B<color=#2F6148><b>\u4E94\u9879\u6027\u72B6\u9700\u6C42</b></color>\u3002\n+
        \u4EE3\u8868\u9700\u8981<color=#2F6148><b>\u63D0\u9AD8</b></color>\uFF0C-
        \u4EE3\u8868\u9700\u8981<color=#2F6148><b>\u964D\u4F4E</b></color>\uFF0C\u7EA6\u7B49\u4E8E
        \u4EE3\u8868\u5DF2\u7ECF<color=#2F6148><b>\u63A5\u8FD1\u76EE\u6807</b></color>\u3002\u7B26\u53F7\u8D8A\u591A\uFF0C\u6240\u9700<color=#2F6148><b>\u8C03\u6574\u5E45\u5EA6\u8D8A\u5927</b></color>\u3002"
      mobileContent: "\u8f7b\u70b9\u5c4f\u5e55\u53f3\u4fa7\u7684<color=#914B2D><b>\u300c\u8fdb\u5316\u7f51\u300d</b></color>\u6309\u94ae\u6253\u5f00\u5730\u56fe\uff0c\u5207\u6362\u5230<color=#2F6148><b>\u8fdb\u5316\u7f51</b></color>\u3002<color=#914B2D><b>\u8f7b\u70b9\u53ef\u67e5\u770b\u7ebf\u7d22\u7684\u751f\u7269\u8282\u70b9</b></color>\uff0c\u4e86\u89e3\u5b83\u7684\u4e94\u9879\u6027\u72b6\u9700\u6c42\uff1b\u518d\u70b9\u7ebf\u7d22\u9762\u677f\u4e2d\u7684<color=#914B2D><b>\u300c\u8bbe\u4e3a\u76ee\u6807\u300d</b></color>\u5f00\u59cb\u8ffd\u8e2a\u3002\n+ \u4ee3\u8868\u9700\u8981\u63d0\u9ad8\uff0c- \u4ee3\u8868\u9700\u8981\u964d\u4f4e\uff0c\u7ea6\u7b49\u4e8e\u4ee3\u8868\u5df2\u7ecf\u63a5\u8fd1\u76ee\u6807\u3002\u7b26\u53f7\u8d8a\u591a\uff0c\u6240\u9700\u8c03\u6574\u5e45\u5ea6\u8d8a\u5927\u3002"
      illustration: {fileID: 0}
      sortOrder: 0
    - id: 6_2
      title: "\u7528\u73AF\u5883\u5F15\u5BFC\u6027\u72B6"
      content: "\u60F3\u8981\u7684\u53D8\u5316 \xB7 \u53EF\u4EE5\u5C1D\u8BD5\u7684\u64CD\u4F5C\n<color=#2F6148><b>\u9002\u6E29</b></color>
        \u63D0\u9AD8 / \u964D\u4F4E \xB7 \u5347\u9AD8 / \u964D\u4F4E\u6E29\u5EA6\n<color=#2F6148><b>\u9002\u6E7F</b></color>
        \u63D0\u9AD8 / \u964D\u4F4E \xB7 \u589E\u52A0 / \u964D\u4F4E\u6E7F\u5EA6\n<color=#2F6148><b>\u8FD0\u52A8</b></color>
        \u63D0\u9AD8 \xB7 \u521B\u9020\u66F4\u6709\u5438\u5F15\u529B\u7684\u90BB\u5730\uFF0C\u9F13\u52B1\u8FC1\u5F99\n<color=#2F6148><b>\u8FD0\u52A8</b></color>
        \u964D\u4F4E \xB7 \u5236\u9020\u5730\u5F62\u9694\u79BB\uFF0C\u6216\u964D\u4F4E\u90BB\u5730\u5438\u5F15\u529B\n<color=#2F6148><b>\u4F53\u578B</b></color>
        \u63D0\u9AD8 / \u964D\u4F4E \xB7 \u589E\u52A0 / \u51CF\u5C11<color=#2F6148><b>\u690D\u7269\u5B58\u91CF</b></color>\n<color=#2F6148><b>\u7E41\u6B96</b></color>
        \u63D0\u9AD8 / \u964D\u4F4E \xB7 \u589E\u52A0 / \u51CF\u5C11<color=#2F6148><b>\u690D\u7269\u589E\u91CF</b></color>\n\u64CD\u4F5C\u53EA\u80FD<color=#2F6148><b>\u5F15\u5BFC\u65B9\u5411</b></color>\uFF0C<color=#2F6148><b>\u4E0D\u80FD\u4FDD\u8BC1</b></color>\u6BCF\u6B21\u90FD\u4EA7\u751F\u76F8\u5E94\u53D8\u5F02\u3002"
      mobileContent: "\u60F3\u8981\u7684\u53D8\u5316 \xB7 \u53EF\u4EE5\u5C1D\u8BD5\u7684\u64CD\u4F5C\n<color=#2F6148><b>\u9002\u6E29</b></color>
        \u63D0\u9AD8 / \u964D\u4F4E \xB7 \u5347\u9AD8 / \u964D\u4F4E\u6E29\u5EA6\n<color=#2F6148><b>\u9002\u6E7F</b></color>
        \u63D0\u9AD8 / \u964D\u4F4E \xB7 \u589E\u52A0 / \u964D\u4F4E\u6E7F\u5EA6\n<color=#2F6148><b>\u8FD0\u52A8</b></color>
        \u63D0\u9AD8 \xB7 \u521B\u9020\u66F4\u6709\u5438\u5F15\u529B\u7684\u90BB\u5730\uFF0C\u9F13\u52B1\u8FC1\u5F99\n<color=#2F6148><b>\u8FD0\u52A8</b></color>
        \u964D\u4F4E \xB7 \u5236\u9020\u5730\u5F62\u9694\u79BB\uFF0C\u6216\u964D\u4F4E\u90BB\u5730\u5438\u5F15\u529B\n<color=#2F6148><b>\u4F53\u578B</b></color>
        \u63D0\u9AD8 / \u964D\u4F4E \xB7 \u589E\u52A0 / \u51CF\u5C11<color=#2F6148><b>\u690D\u7269\u5B58\u91CF</b></color>\n<color=#2F6148><b>\u7E41\u6B96</b></color>
        \u63D0\u9AD8 / \u964D\u4F4E \xB7 \u589E\u52A0 / \u51CF\u5C11<color=#2F6148><b>\u690D\u7269\u589E\u91CF</b></color>\n\u64CD\u4F5C\u53EA\u80FD<color=#2F6148><b>\u5F15\u5BFC\u65B9\u5411</b></color>\uFF0C<color=#2F6148><b>\u4E0D\u80FD\u4FDD\u8BC1</b></color>\u6BCF\u6B21\u90FD\u4EA7\u751F\u76F8\u5E94\u53D8\u5F02\u3002"
      illustration: {fileID: 0}
      sortOrder: 1
    - id: 6_3
      title: "\u6293\u4F4F\u8FDB\u5316\u65F6\u673A"
      content: "\u53EF\u4EE5\u5148\u96C6\u4E2D\u5F15\u5BFC\u4E00\u9879\u6027\u72B6\uFF0C\u518D\u6839\u636E\u8FDB\u5316\u9700\u6C42\u8C03\u6574\u7B56\u7565\u3002\n\u5F53\u67D0\u9879\u6027\u72B6<color=#2F6148><b>\u63A5\u8FD1\u76EE\u6807</b></color>\u65F6\uFF0C\u53EF\u4EE5\u8003\u8651<color=#2F6148><b>\u64A4\u9500\u5F53\u524D\u5E72\u9884</b></color>\uFF0C\u8F6C\u800C\u5173\u6CE8\u5176\u4ED6\u6027\u72B6\u3002\n<color=#2F6148><b>\u89C2\u5BDF\u7B14\u8BB0</b></color>\uFF1A\u7559\u610F\u8FDB\u5316\u9700\u6C42\u7684\u53D8\u5316\uFF1B\u73AF\u5883\u5E72\u9884\u7ED3\u675F\u540E\uFF0C\u79CD\u7FA4\u4ECD\u4F1A\u7EE7\u7EED<color=#2F6148><b>\u81EA\u7136\u6F14\u5316</b></color>\u3002"
      mobileContent: "\u53EF\u4EE5\u5148\u96C6\u4E2D\u5F15\u5BFC\u4E00\u9879\u6027\u72B6\uFF0C\u518D\u6839\u636E\u8FDB\u5316\u9700\u6C42\u8C03\u6574\u7B56\u7565\u3002\n\u5F53\u67D0\u9879\u6027\u72B6<color=#2F6148><b>\u63A5\u8FD1\u76EE\u6807</b></color>\u65F6\uFF0C\u53EF\u4EE5\u8003\u8651<color=#2F6148><b>\u64A4\u9500\u5F53\u524D\u5E72\u9884</b></color>\uFF0C\u8F6C\u800C\u5173\u6CE8\u5176\u4ED6\u6027\u72B6\u3002\n<color=#2F6148><b>\u89C2\u5BDF\u7B14\u8BB0</b></color>\uFF1A\u7559\u610F\u8FDB\u5316\u9700\u6C42\u7684\u53D8\u5316\uFF1B\u73AF\u5883\u5E72\u9884\u7ED3\u675F\u540E\uFF0C\u79CD\u7FA4\u4ECD\u4F1A\u7EE7\u7EED<color=#2F6148><b>\u81EA\u7136\u6F14\u5316</b></color>\u3002"
      illustration: {fileID: 0}
      sortOrder: 2
    - id: 6_4
      title: "\u8FCE\u63A5\u65B0\u7269\u79CD"
      content: "\u5F53<color=#2F6148><b>\u4E94\u9879\u6027\u72B6\u63A5\u8FD1\u76EE\u6807</b></color>\uFF0C\u5E76<color=#2F6148><b>\u6301\u7EED\u6EE1\u8DB3\u8FDB\u5316\u6761\u4EF6</b></color>\u65F6\uFF0C\u79CD\u7FA4\u4FBF\u6709\u673A\u4F1A\u6B63\u5F0F\u5206\u5316\u3002\n\u4E00\u90E8\u5206\u539F\u6709\u79CD\u7FA4\u6210\u4E3A\u65B0\u7269\u79CD\uFF0C<color=#2F6148><b>\u6BCD\u79CD\u7FA4\u4ECD\u7136\u4FDD\u7559</b></color>\u3002\n\u8FDB\u5316\u6210\u529F\u53EA\u662F\u5F00\u59CB\uFF0C<color=#2F6148><b>\u8BA9\u65B0\u7269\u79CD\u5B58\u6D3B\u4E0B\u6765</b></color>\u540C\u6837\u91CD\u8981\u3002"
      mobileContent: "\u5F53<color=#2F6148><b>\u4E94\u9879\u6027\u72B6\u63A5\u8FD1\u76EE\u6807</b></color>\uFF0C\u5E76<color=#2F6148><b>\u6301\u7EED\u6EE1\u8DB3\u8FDB\u5316\u6761\u4EF6</b></color>\u65F6\uFF0C\u79CD\u7FA4\u4FBF\u6709\u673A\u4F1A\u6B63\u5F0F\u5206\u5316\u3002\n\u4E00\u90E8\u5206\u539F\u6709\u79CD\u7FA4\u6210\u4E3A\u65B0\u7269\u79CD\uFF0C<color=#2F6148><b>\u6BCD\u79CD\u7FA4\u4ECD\u7136\u4FDD\u7559</b></color>\u3002\n\u8FDB\u5316\u6210\u529F\u53EA\u662F\u5F00\u59CB\uFF0C<color=#2F6148><b>\u8BA9\u65B0\u7269\u79CD\u5B58\u6D3B\u4E0B\u6765</b></color>\u540C\u6837\u91CD\u8981\u3002"
      illustration: {fileID: 21300000, guid: 319627fbbda5a0f4da896fc53af25105, type: 3}
      sortOrder: 3
  - id: chapter7
    title: "\u751F\u547D\u7684\u4EF7\u503C"
    sortOrder: 6
    pages:
    - id: 7_1
      title: "\u751F\u7269\u80FD"
      content: "<color=#914B2D><b>\u89C4\u5212\u73A9\u6CD5\uFF1A\u5F53\u524D\u6D4B\u8BD5\u7248\u53EF\u80FD\u5173\u95ED\u7ECF\u6D4E\u7CFB\u7EDF\u3002</b></color>\n\u751F\u547D\u4E0D\u4EC5\u4F1A\u6D88\u8017\u8D44\u6E90\uFF0C\u4E5F\u4F1A\u4E3A\u519C\u573A\u5E26\u6765\u73CD\u8D35\u7684<color=#2F6148><b>\u751F\u7269\u80FD</b></color>\u3002\n\u6BCF\u4E00\u79CD\u751F\u7269\u90FD\u4F1A<color=#2F6148><b>\u968F\u7740\u65F6\u95F4\u81EA\u7136\u4EA7\u751F</b></color><color=#2F6148><b>\u751F\u7269\u80FD</b></color>\u3002\u79CD\u7FA4\u8D8A\u7E41\u76DB\uFF0C\u79EF\u7D2F\u7684<color=#2F6148><b>\u751F\u7269\u80FD</b></color>\u4E5F\u53EF\u80FD\u8D8A\u591A\u3002\n<color=#2F6148><b>\u751F\u7269\u80FD</b></color>\u662F\u4F60\u57F9\u80B2\u8FD9\u9897\u661F\u7403\u7684\u91CD\u8981\u8D44\u6E90\u3002"
      mobileContent: "<color=#914B2D><b>\u89C4\u5212\u73A9\u6CD5\uFF1A\u5F53\u524D\u6D4B\u8BD5\u7248\u53EF\u80FD\u5173\u95ED\u7ECF\u6D4E\u7CFB\u7EDF\u3002</b></color>\n\u751F\u547D\u4E0D\u4EC5\u4F1A\u6D88\u8017\u8D44\u6E90\uFF0C\u4E5F\u4F1A\u4E3A\u519C\u573A\u5E26\u6765\u73CD\u8D35\u7684<color=#2F6148><b>\u751F\u7269\u80FD</b></color>\u3002\n\u6BCF\u4E00\u79CD\u751F\u7269\u90FD\u4F1A<color=#2F6148><b>\u968F\u7740\u65F6\u95F4\u81EA\u7136\u4EA7\u751F</b></color><color=#2F6148><b>\u751F\u7269\u80FD</b></color>\u3002\u79CD\u7FA4\u8D8A\u7E41\u76DB\uFF0C\u79EF\u7D2F\u7684<color=#2F6148><b>\u751F\u7269\u80FD</b></color>\u4E5F\u53EF\u80FD\u8D8A\u591A\u3002\n<color=#2F6148><b>\u751F\u7269\u80FD</b></color>\u662F\u4F60\u57F9\u80B2\u8FD9\u9897\u661F\u7403\u7684\u91CD\u8981\u8D44\u6E90\u3002"
      illustration: {fileID: 0}
