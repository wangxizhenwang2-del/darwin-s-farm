  - id: chapter1
    title: "\u521D\u8BC6\u519C\u573A"
    sortOrder: 0
    pages:
    - id: 1_1
      title: "\u4F60\u662F\u8C01\uFF1F"
      content: "<color=#2F6148><b>\u6B22\u8FCE\u6765\u5230\u8FBE\u5C14\u6587\u519C\u573A\uFF01</b></color>\n\u5728\u4E00\u9897\u9065\u8FDC\u7684\u661F\u7403\u4E0A\uFF0C\u4E00\u573A\u5173\u4E8E\u751F\u547D\u7684\u5B9E\u9A8C\u5373\u5C06\u5F00\u59CB\u3002\n\u4F60\u662F\u4E00\u540D<color=#2F6148><b>\u661F\u9645\u751F\u6001\u57F9\u80B2\u8005</b></color>\uFF0C\u8D1F\u8D23\u7167\u6599\u8FD9\u7247\u5E74\u8F7B\u7684\u751F\u547D\u5B9E\u9A8C\u573A\u3002\n\u5728\u8FD9\u91CC\uFF0C\u4F60\u4E0D\u9700\u8981\u6307\u6325\u6BCF\u4E00\u53EA\u751F\u7269\u3002\u5B83\u4EEC\u4F1A\u81EA\u884C\u89C5\u98DF\u3001\u7E41\u6B96\u3001\u7ADE\u4E89\uFF0C\u4E5F\u53EF\u80FD\u8FC1\u5F99\u5230\u65B0\u7684\u571F\u5730\u3002\n\u4F60\u771F\u6B63\u80FD\u591F\u638C\u63A7\u7684\uFF0C\u662F<color=#2F6148><b>\u5B83\u4EEC\u751F\u6D3B\u7684\u73AF\u5883</b></color>\u3002\n\u6539\u53D8\u6C14\u5019\u3001\u8C03\u6574\u98DF\u7269\u4F9B\u7ED9\u3001\u5F00\u8F9F\u65B0\u7684\u6816\u606F\u5730\uFF0C\u7136\u540E\u9759\u9759\u89C2\u5BDF\u2014\u2014\u751F\u547D\u5C06\u5982\u4F55\u56DE\u5E94\u4F60\u7684\u9009\u62E9\uFF1F"
      mobileContent: "<color=#2F6148><b>\u6B22\u8FCE\u6765\u5230\u8FBE\u5C14\u6587\u519C\u573A\uFF01</b></color>\n\u5728\u4E00\u9897\u9065\u8FDC\u7684\u661F\u7403\u4E0A\uFF0C\u4E00\u573A\u5173\u4E8E\u751F\u547D\u7684\u5B9E\u9A8C\u5373\u5C06\u5F00\u59CB\u3002\n\u4F60\u662F\u4E00\u540D<color=#2F6148><b>\u661F\u9645\u751F\u6001\u57F9\u80B2\u8005</b></color>\uFF0C\u8D1F\u8D23\u7167\u6599\u8FD9\u7247\u5E74\u8F7B\u7684\u751F\u547D\u5B9E\u9A8C\u573A\u3002\n\u5728\u8FD9\u91CC\uFF0C\u4F60\u4E0D\u9700\u8981\u6307\u6325\u6BCF\u4E00\u53EA\u751F\u7269\u3002\u5B83\u4EEC\u4F1A\u81EA\u884C\u89C5\u98DF\u3001\u7E41\u6B96\u3001\u7ADE\u4E89\uFF0C\u4E5F\u53EF\u80FD\u8FC1\u5F99\u5230\u65B0\u7684\u571F\u5730\u3002\n\u4F60\u771F\u6B63\u80FD\u591F\u638C\u63A7\u7684\uFF0C\u662F<color=#2F6148><b>\u5B83\u4EEC\u751F\u6D3B\u7684\u73AF\u5883</b></color>\u3002\n\u6539\u53D8\u6C14\u5019\u3001\u8C03\u6574\u98DF\u7269\u4F9B\u7ED9\u3001\u5F00\u8F9F\u65B0\u7684\u6816\u606F\u5730\uFF0C\u7136\u540E\u9759\u9759\u89C2\u5BDF\u2014\u2014\u751F\u547D\u5C06\u5982\u4F55\u56DE\u5E94\u4F60\u7684\u9009\u62E9\uFF1F"
      illustration: {fileID: 0}
      sortOrder: 0
    - id: 1_2
      title: "\u751F\u547D\u5982\u4F55\u6D8C\u73B0\uFF1F"
      content: "<color=#2F6148><b>\u751F\u547D\u4F1A\u627E\u5230\u81EA\u5DF1\u7684\u9053\u8DEF</b></color>\n\u6BCF\u4E00\u79CD\u751F\u7269\u90FD\u6709\u81EA\u5DF1\u7684\u751F\u5B58\u65B9\u5F0F\u3002\n\u6709\u7684\u9002\u5E94\u708E\u70ED\uFF0C\u6709\u7684\u559C\u6B22\u6F6E\u6E7F\uFF1B\u6709\u7684\u64C5\u957F\u5954\u8DD1\uFF0C\u6709\u7684\u4F9D\u9760\u65FA\u76DB\u7684\u7E41\u6B96\u80FD\u529B\u5EF6\u7EED\u79CD\u7FA4\u3002\n\u5F53\u73AF\u5883\u53D1\u751F\u53D8\u5316\uFF0C\u539F\u672C\u9002\u5408\u751F\u5B58\u7684\u6027\u72B6\u53EF\u80FD\u53D8\u6210\u8D1F\u62C5\uFF0C\u800C\u4E0D\u8D77\u773C\u7684\u7279\u5F81\u4E5F\u53EF\u80FD\u6210\u4E3A\u65B0\u7684\u4F18\u52BF\u3002\n\u968F\u7740\u4E00\u4EE3\u4EE3\u751F\u547D\u66F4\u66FF\uFF0C\u79CD\u7FA4\u4F1A\u9010\u6E10\u53D1\u751F\u53D8\u5316\u3002\n\u5F53\u8FD9\u4E9B\u53D8\u5316\u79EF\u7D2F\u5230\u4E00\u5B9A\u7A0B\u5EA6\uFF0C\u4E00\u4E2A\u5168\u65B0\u7684\u7269\u79CD\u4FBF\u53EF\u80FD\u8BDE\u751F\u3002\n\u4F60\u65E0\u6CD5\u76F4\u63A5\u547D\u4EE4\u751F\u547D\u8FDB\u5316\uFF0C\u5374\u53EF\u4EE5<color=#2F6148><b>\u6539\u53D8\u5B83\u4EEC\u8FDB\u5316\u7684\u65B9\u5411</b></color>\u3002"
      mobileContent: "<color=#2F6148><b>\u751F\u547D\u4F1A\u627E\u5230\u81EA\u5DF1\u7684\u9053\u8DEF</b></color>\n\u6BCF\u4E00\u79CD\u751F\u7269\u90FD\u6709\u81EA\u5DF1\u7684\u751F\u5B58\u65B9\u5F0F\u3002\n\u6709\u7684\u9002\u5E94\u708E\u70ED\uFF0C\u6709\u7684\u559C\u6B22\u6F6E\u6E7F\uFF1B\u6709\u7684\u64C5\u957F\u5954\u8DD1\uFF0C\u6709\u7684\u4F9D\u9760\u65FA\u76DB\u7684\u7E41\u6B96\u80FD\u529B\u5EF6\u7EED\u79CD\u7FA4\u3002\n\u5F53\u73AF\u5883\u53D1\u751F\u53D8\u5316\uFF0C\u539F\u672C\u9002\u5408\u751F\u5B58\u7684\u6027\u72B6\u53EF\u80FD\u53D8\u6210\u8D1F\u62C5\uFF0C\u800C\u4E0D\u8D77\u773C\u7684\u7279\u5F81\u4E5F\u53EF\u80FD\u6210\u4E3A\u65B0\u7684\u4F18\u52BF\u3002\n\u968F\u7740\u4E00\u4EE3\u4EE3\u751F\u547D\u66F4\u66FF\uFF0C\u79CD\u7FA4\u4F1A\u9010\u6E10\u53D1\u751F\u53D8\u5316\u3002\n\u5F53\u8FD9\u4E9B\u53D8\u5316\u79EF\u7D2F\u5230\u4E00\u5B9A\u7A0B\u5EA6\uFF0C\u4E00\u4E2A\u5168\u65B0\u7684\u7269\u79CD\u4FBF\u53EF\u80FD\u8BDE\u751F\u3002\n\u4F60\u65E0\u6CD5\u76F4\u63A5\u547D\u4EE4\u751F\u547D\u8FDB\u5316\uFF0C\u5374\u53EF\u4EE5<color=#2F6148><b>\u6539\u53D8\u5B83\u4EEC\u8FDB\u5316\u7684\u65B9\u5411</b></color>\u3002"
      illustration: {fileID: 0}
      sortOrder: 1
    - id: 1_3
      title: "\u4F60\u7684\u76EE\u6807"
      content: "\u57F9\u80B2\u5C5E\u4E8E\u4F60\u7684\u751F\u547D\u4E16\u754C\n\u4F60\u7684\u65C5\u7A0B\u5C06\u4ECE\u6700\u521D\u7684\u9E21\u79CD\u7FA4\u5F00\u59CB\u3002\n\u901A\u8FC7\u8C03\u6574\u73AF\u5883\uFF0C\u5F15\u5BFC\u5B83\u4EEC\u6CBF\u7740\u4E0D\u540C\u7684\u6F14\u5316\u9053\u8DEF\u524D\u8FDB\uFF0C\u9010\u6E10\u53D1\u73B0\u5F69\u9E21\u3001\u5B54\u96C0\u3001\u7075\u611F\u83C7\u72F8\u4E0E\u9E7F\u3002\n\u4F46\u53D1\u73B0\u65B0\u7269\u79CD\u53EA\u662F\u7B2C\u4E00\u6B65\u3002\n\u6BCF\u4E00\u79CD\u751F\u547D\u90FD\u9700\u8981\u98DF\u7269\u4E0E\u5408\u9002\u7684\u6816\u606F\u5730\uFF0C\u5B83\u4EEC\u53EF\u80FD\u76F8\u4E92\u7ADE\u4E89\uFF0C\u4E5F\u53EF\u80FD\u56E0\u4E3A\u73AF\u5883\u53D8\u5316\u800C\u6D88\u5931\u3002\n\u4F60\u7684<color=#2F6148><b>\u6700\u7EC8\u76EE\u6807</b></color>\uFF0C\u662F\u8BA9<color=#2F6148><b>\u9E21\u3001\u5F69\u9E21\u3001\u5B54\u96C0\u3001\u7075\u611F\u83C7\u72F8\u548C\u9E7F\u4E94\u79CD\u751F\u547D\u5728\u540C\u4E00\u4E2A\u751F\u6001\u4E16\u754C\u4E2D\u5171\u5B58</b></color>\u3002\n<color=#2F6148><b>\u89C2\u5BDF\u7B14\u8BB0</b></color>\uFF1A\u8FDB\u5316\u6210\u529F\u4E0D\u4EE3\u8868\u57F9\u80B2\u7ED3\u675F\u3002\u8BA9\u65B0\u751F\u547D\u5728<color=#2F6148><b>\u751F\u6001\u7CFB\u7EDF\u4E2D\u5EF6\u7EED</b></color>\u4E0B\u53BB\uFF0C\u540C\u6837\u91CD\u8981\u3002"
      mobileContent: "\u57F9\u80B2\u5C5E\u4E8E\u4F60\u7684\u751F\u547D\u4E16\u754C\n\u4F60\u7684\u65C5\u7A0B\u5C06\u4ECE\u6700\u521D\u7684\u9E21\u79CD\u7FA4\u5F00\u59CB\u3002\n\u901A\u8FC7\u8C03\u6574\u73AF\u5883\uFF0C\u5F15\u5BFC\u5B83\u4EEC\u6CBF\u7740\u4E0D\u540C\u7684\u6F14\u5316\u9053\u8DEF\u524D\u8FDB\uFF0C\u9010\u6E10\u53D1\u73B0\u5F69\u9E21\u3001\u5B54\u96C0\u3001\u7075\u611F\u83C7\u72F8\u4E0E\u9E7F\u3002\n\u4F46\u53D1\u73B0\u65B0\u7269\u79CD\u53EA\u662F\u7B2C\u4E00\u6B65\u3002\n\u6BCF\u4E00\u79CD\u751F\u547D\u90FD\u9700\u8981\u98DF\u7269\u4E0E\u5408\u9002\u7684\u6816\u606F\u5730\uFF0C\u5B83\u4EEC\u53EF\u80FD\u76F8\u4E92\u7ADE\u4E89\uFF0C\u4E5F\u53EF\u80FD\u56E0\u4E3A\u73AF\u5883\u53D8\u5316\u800C\u6D88\u5931\u3002\n\u4F60\u7684<color=#2F6148><b>\u6700\u7EC8\u76EE\u6807</b></color>\uFF0C\u662F\u8BA9<color=#2F6148><b>\u9E21\u3001\u5F69\u9E21\u3001\u5B54\u96C0\u3001\u7075\u611F\u83C7\u72F8\u548C\u9E7F\u4E94\u79CD\u751F\u547D\u5728\u540C\u4E00\u4E2A\u751F\u6001\u4E16\u754C\u4E2D\u5171\u5B58</b></color>\u3002\n<color=#2F6148><b>\u89C2\u5BDF\u7B14\u8BB0</b></color>\uFF1A\u8FDB\u5316\u6210\u529F\u4E0D\u4EE3\u8868\u57F9\u80B2\u7ED3\u675F\u3002\u8BA9\u65B0\u751F\u547D\u5728<color=#2F6148><b>\u751F\u6001\u7CFB\u7EDF\u4E2D\u5EF6\u7EED</b></color>\u4E0B\u53BB\uFF0C\u540C\u6837\u91CD\u8981\u3002"
      illustration: {fileID: 21300000, guid: 319627fbbda5a0f4da896fc53af25105, type: 3}
      sortOrder: 2
  - id: chapter2
    title: "\u8BA4\u8BC6\u5730\u5757"
    sortOrder: 1
    pages:
    - id: 2_1
      title: "\u4E00\u5757\u571F\u5730"
      content: "<color=#2F6148><b>\u4ECE\u4E00\u5757\u571F\u5730\u5F00\u59CB</b></color>\n\u4F60\u7684\u519C\u573A\u7531\u4E00\u5757\u5757\u72EC\u7ACB\u7684\u571F\u5730\u7EC4\u6210\uFF0C\u6211\u4EEC\u79F0\u5B83\u4EEC\u4E3A<color=#2F6148><b>\u5730\u5757</b></color>\u3002\n\u6BCF\u5757<color=#2F6148><b>\u5730\u5757</b></color>\u90FD\u6709\u81EA\u5DF1\u7684<color=#2F6148><b>\u6E29\u5EA6\u3001\u6E7F\u5EA6\u3001\u6D77\u62D4\u548C\u690D\u7269\u8D44\u6E90</b></color>\uFF0C\u4E5F\u751F\u6D3B\u7740\u4E0D\u540C\u7684\u751F\u7269\u79CD\u7FA4\u3002\n\u6309\u4F4F
        <color=#914B2D><b>Alt</b></color> \u5E76\u7528<color=#914B2D><b>\u9F20\u6807\u5DE6\u952E\u5355\u51FB\u5730\u5757</b></color>\uFF0C\u5373\u53EF\u67E5\u770B\u5B83\u7684\u73AF\u5883\u548C\u751F\u7269\u4FE1\u606F\u3002\n\u4F60\u8FD8\u53EF\u4EE5\u8C03\u6574<color=#2F6148><b>\u5730\u5757</b></color>\u7684\u73AF\u5883\uFF0C\u6539\u53D8\u751F\u7269\u6240\u9762\u4E34\u7684\u751F\u5B58\u6761\u4EF6\u3002\n\u540C\u4E00\u79CD\u751F\u7269\uFF0C\u5728\u4E0D\u540C<color=#2F6148><b>\u5730\u5757</b></color>\u4E0A\uFF0C\u4E5F\u53EF\u80FD\u8D70\u5411<color=#2F6148><b>\u4E0D\u540C\u7684\u6F14\u5316\u9053\u8DEF</b></color>\u3002\n<color=#2F6148><b>\u64CD\u4F5C\u63D0\u793A</b></color>\uFF1A\u76F4\u63A5\u6309\u4F4F<color=#914B2D><b>\u9F20\u6807\u4E2D\u952E</b></color>\u62D6\u52A8\u4EE5\u5E73\u79FB\u5730\u56FE\uFF0C\u6EDA\u52A8<color=#914B2D><b>\u9F20\u6807\u6EDA\u8F6E</b></color>\u653E\u5927\u6216\u7F29\u5C0F\u753B\u9762\u3002\u5E73\u79FB\u548C\u7F29\u653E\u65E0\u9700\u6309\u4F4F
        Alt\u3002"
      mobileContent: "<color=#2F6148><b>\u4ECE\u4E00\u5757\u571F\u5730\u5F00\u59CB</b></color>\n\u4F60\u7684\u519C\u573A\u7531\u4E00\u5757\u5757\u72EC\u7ACB\u7684\u571F\u5730\u7EC4\u6210\uFF0C\u6211\u4EEC\u79F0\u5B83\u4EEC\u4E3A<color=#2F6148><b>\u5730\u5757</b></color>\u3002\n\u6BCF\u5757<color=#2F6148><b>\u5730\u5757</b></color>\u90FD\u6709\u81EA\u5DF1\u7684<color=#2F6148><b>\u6E29\u5EA6\u3001\u6E7F\u5EA6\u3001\u6D77\u62D4\u548C\u690D\u7269\u8D44\u6E90</b></color>\uFF0C\u4E5F\u751F\u6D3B\u7740\u4E0D\u540C\u7684\u751F\u7269\u79CD\u7FA4\u3002\n\u5728\u89E6\u5C4F\u4E0A<color=#914B2D><b>\u957F\u6309\u5730\u5757</b></color>\uFF0C\u5373\u53EF\u67E5\u770B\u5B83\u7684\u73AF\u5883\u548C\u751F\u7269\u4FE1\u606F\u3002\n\u4F60\u8FD8\u53EF\u4EE5\u8C03\u6574<color=#2F6148><b>\u5730\u5757</b></color>\u7684\u73AF\u5883\uFF0C\u6539\u53D8\u751F\u7269\u6240\u9762\u4E34\u7684\u751F\u5B58\u6761\u4EF6\u3002\n\u540C\u4E00\u79CD\u751F\u7269\uFF0C\u5728\u4E0D\u540C<color=#2F6148><b>\u5730\u5757</b></color>\u4E0A\uFF0C\u4E5F\u53EF\u80FD\u8D70\u5411<color=#2F6148><b>\u4E0D\u540C\u7684\u6F14\u5316\u9053\u8DEF</b></color>\u3002\n<color=#2F6148><b>\u64CD\u4F5C\u63D0\u793A</b></color>\uFF1A<color=#914B2D><b>\u5355\u6307\u62D6\u52A8</b></color>\u5E73\u79FB\u89C6\u89D2\uFF0C<color=#914B2D><b>\u53CC\u6307\u634F\u5408</b></color>\u7F29\u653E\u753B\u9762\u3002"
      illustration: {fileID: 0}
      sortOrder: 0
    - id: 2_2
      title: "\u4E0D\u540C\u7684\u5730\u8C8C"
      content: "<color=#2F6148><b>\u6C14\u5019\u5851\u9020\u571F\u5730</b></color>\n\u4F60\u53EF\u80FD\u9047\u89C1\u5E72\u71E5\u7684\u8352\u6F20\u3001\u6E7F\u6DA6\u7684\u96E8\u6797\u3001\u5BD2\u51B7\u7684\u96EA\u5C71\uFF0C\u6216\u70BD\u70ED\u7684\u706B\u5C71\u3002\n\u4E00\u5757\u571F\u5730\u7684\u5730\u8C8C\u7531<color=#2F6148><b>\u6E29\u5EA6\u3001\u6E7F\u5EA6\u548C\u6D77\u62D4</b></color>\u5171\u540C\u51B3\u5B9A\u3002\u4E0D\u540C\u5730\u8C8C\u4E5F\u62E5\u6709\u4E0D\u540C\u7684\u690D\u7269\u8D44\u6E90\u6761\u4EF6\u3002\n\u6539\u53D8\u5730\u5757\u73AF\u5883\uFF0C\u53EF\u80FD\u8BA9\u5B83\u9010\u6E10\u5448\u73B0\u51FA\u53E6\u4E00\u79CD\u5730\u8C8C\u3002\n<color=#2F6148><b>\u64CD\u4F5C\u63D0\u793A</b></color>\uFF1A\u67E5\u770B\u7269\u79CD<color=#2F6148><b>\u9002\u5B9C\u7684\u6E29\u5EA6\u4E0E\u6E7F\u5EA6</b></color>\uFF0C\u5E76\u4E0E\u5730\u5757\u73AF\u5883\u8FDB\u884C\u6BD4\u8F83\u3002"
      mobileContent: "<color=#2F6148><b>\u6C14\u5019\u5851\u9020\u571F\u5730</b></color>\n\u4F60\u53EF\u80FD\u9047\u89C1\u5E72\u71E5\u7684\u8352\u6F20\u3001\u6E7F\u6DA6\u7684\u96E8\u6797\u3001\u5BD2\u51B7\u7684\u96EA\u5C71\uFF0C\u6216\u70BD\u70ED\u7684\u706B\u5C71\u3002\n\u4E00\u5757\u571F\u5730\u7684\u5730\u8C8C\u7531<color=#2F6148><b>\u6E29\u5EA6\u3001\u6E7F\u5EA6\u548C\u6D77\u62D4</b></color>\u5171\u540C\u51B3\u5B9A\u3002\u4E0D\u540C\u5730\u8C8C\u4E5F\u62E5\u6709\u4E0D\u540C\u7684\u690D\u7269\u8D44\u6E90\u6761\u4EF6\u3002\n\u6539\u53D8\u5730\u5757\u73AF\u5883\uFF0C\u53EF\u80FD\u8BA9\u5B83\u9010\u6E10\u5448\u73B0\u51FA\u53E6\u4E00\u79CD\u5730\u8C8C\u3002\n<color=#2F6148><b>\u64CD\u4F5C\u63D0\u793A</b></color>\uFF1A\u67E5\u770B\u7269\u79CD<color=#2F6148><b>\u9002\u5B9C\u7684\u6E29\u5EA6\u4E0E\u6E7F\u5EA6</b></color>\uFF0C\u5E76\u4E0E\u5730\u5757\u73AF\u5883\u8FDB\u884C\u6BD4\u8F83\u3002"
      illustration: {fileID: 21300000, guid: 1a70cce2566d4eacafe1d891d79ee7f9, type: 3}
      sortOrder: 1
    - id: 2_3
      title: "\u76F8\u90BB\u5730\u5757"
      content: "<color=#2F6148><b>\u8BA9\u519C\u573A\u5411\u5916\u5EF6\u4F38</b></color>\n\u9664\u4E86\u6700\u521D\u7684\u571F\u5730\uFF0C\u4F60\u8FD8\u53EF\u4EE5\u5411\u5468\u56F4\u6269\u5C55\u5730\u5757\u3002\n<color=#2F6148><b>\u76F8\u90BB\u5730\u5757</b></color>\u53EF\u4EE5\u62E5\u6709\u4E0D\u540C\u73AF\u5883\uFF0C\u4E3A\u4E0D\u540C\u79CD\u7FA4\u63D0\u4F9B\u6816\u606F\u5730\u3002\u5730\u5757\u4E4B\u95F4\u80FD\u591F\u901A\u884C\u65F6\uFF0C\u751F\u7269\u8FD8\u6709\u673A\u4F1A\u81EA\u884C\u8FC1\u5F99\u3002\n<color=#2F6148><b>\u6D77\u62D4\u5DEE</b></color>\u4F1A\u5F71\u54CD\u901A\u884C\uFF1B\u9AD8\u5DEE\u8D8A\u5927\uFF0C\u8FC1\u5F99\u8D8A\u56F0\u96BE\u3002\n\u6269\u5C55\u5730\u5757\uFF0C\u4E5F\u662F\u5728\u521B\u9020<color=#2F6148><b>\u65B0\u7684\u6F14\u5316\u673A\u4F1A</b></color>\u3002\n<color=#2F6148><b>\u64CD\u4F5C\u63D0\u793A</b></color>\uFF1A\u6309
        <color=#914B2D><b>N</b></color> \u6253\u5F00\u571F\u5730\u5EFA\u9020\u680F\uFF0C\u4ECE\u4E0B\u65B9\u680F\u62D6\u52A8\u571F\u5730\u5230\u76EE\u6807\u683C\u5B50\u8FDB\u884C\u5EFA\u9020\u3002"
      mobileContent: "<color=#2F6148><b>\u8BA9\u519C\u573A\u5411\u5916\u5EF6\u4F38</b></color>\n\u9664\u4E86\u6700\u521D\u7684\u571F\u5730\uFF0C\u4F60\u8FD8\u53EF\u4EE5\u5411\u5468\u56F4\u6269\u5C55\u5730\u5757\u3002\n<color=#2F6148><b>\u76F8\u90BB\u5730\u5757</b></color>\u53EF\u4EE5\u62E5\u6709\u4E0D\u540C\u73AF\u5883\uFF0C\u4E3A\u4E0D\u540C\u79CD\u7FA4\u63D0\u4F9B\u6816\u606F\u5730\u3002\u5730\u5757\u4E4B\u95F4\u80FD\u591F\u901A\u884C\u65F6\uFF0C\u751F\u7269\u8FD8\u6709\u673A\u4F1A\u81EA\u884C\u8FC1\u5F99\u3002\n<color=#2F6148><b>\u6D77\u62D4\u5DEE</b></color>\u4F1A\u5F71\u54CD\u901A\u884C\uFF1B\u9AD8\u5DEE\u8D8A\u5927\uFF0C\u8FC1\u5F99\u8D8A\u56F0\u96BE\u3002\n\u6269\u5C55\u5730\u5757\uFF0C\u4E5F\u662F\u5728\u521B\u9020<color=#2F6148><b>\u65B0\u7684\u6F14\u5316\u673A\u4F1A</b></color>\u3002\n<color=#2F6148><b>\u64CD\u4F5C\u63D0\u793A</b></color>\uFF1A\u70B9\u51FB\u300C<color=#914B2D><b>\u5EFA\u9020\u5730\u5757</b></color>\u300D\uFF0C\u9009\u62E9\u571F\u5730\uFF0C\u518D\u5728\u76EE\u6807\u683C\u5B50<color=#914B2D><b>\u786E\u8BA4\u5EFA\u9020</b></color>\u3002"
      illustration: {fileID: 21300000, guid: 1a70cce2566d4eacafe1d891d79ee7f9, type: 3}
      sortOrder: 2
  - id: chapter3
    title: "\u73AF\u5883\u4E0E\u8D44\u6E90"
    sortOrder: 2
    pages:
    - id: 3_1
      title: "\u4F7F\u7528\u73AF\u5883\u5DE5\u5177"
      content: "\u753B\u9762\u5DE6\u4FA7\u6709\u4E94\u79CD<color=#914B2D><b>\u73AF\u5883\u5DE5\u5177</b></color>\uFF1A<color=#2F6148><b>\u690D\u7269\u589E\u91CF</b></color>\u3001<color=#2F6148><b>\u690D\u7269\u5B58\u91CF</b></color>\u3001<color=#2F6148><b>\u6E29\u5EA6</b></color>\u3001<color=#2F6148><b>\u6E7F\u5EA6</b></color>\u3001<color=#2F6148><b>\u6D77\u62D4</b></color>\u3002\n\u6BCF\u79CD\u5DE5\u5177\u90FD\u6709\u4E0D\u540C\u6863\u4F4D\uFF0C\u7528\u6765\u8C03\u6574<color=#2F6148><b>\u53D8\u5316\u65B9\u5411\u548C\u5F3A\u5EA6</b></color>\u3002\n<color=#2F6148><b>\u64CD\u4F5C\u6B65\u9AA4</b></color>\uFF1A\u9009\u62E9\u5DE6\u4FA7\u5DE5\u5177\uFF0C\u518D<color=#914B2D><b>\u9009\u62E9\u6863\u4F4D</b></color>\uFF0C\u518D\u70B9\u51FB\u5730\u5757\uFF0C\u518D\u70B9\u51FB\u300C<color=#914B2D><b>\u5E94\u7528</b></color>\u300D\u3002\n\u8981\u53D6\u6D88\u5DF2\u6709\u5E72\u9884\uFF0C\u91CD\u65B0\u9009\u4E2D\u5BF9\u5E94\u5DE5\u5177\u4E0E\u5730\u5757\uFF0C\u70B9\u51FB\u300C<color=#914B2D><b>\u64A4\u9500</b></color>\u300D\u3002"
      mobileContent: "\u70B9\u51FB\u300C<color=#914B2D><b>\u73AF\u5883\u5DE5\u5177</b></color>\u300D\u53EF\u9009\u62E9\u4E94\u79CD\u5DE5\u5177\uFF1A<color=#2F6148><b>\u690D\u7269\u589E\u91CF</b></color>\u3001<color=#2F6148><b>\u690D\u7269\u5B58\u91CF</b></color>\u3001<color=#2F6148><b>\u6E29\u5EA6</b></color>\u3001<color=#2F6148><b>\u6E7F\u5EA6</b></color>\u3001<color=#2F6148><b>\u6D77\u62D4</b></color>\u3002\n\u6BCF\u79CD\u5DE5\u5177\u90FD\u6709\u4E0D\u540C\u6863\u4F4D\uFF0C\u7528\u6765\u8C03\u6574<color=#2F6148><b>\u53D8\u5316\u65B9\u5411\u548C\u5F3A\u5EA6</b></color>\u3002\n<color=#2F6148><b>\u64CD\u4F5C\u6B65\u9AA4</b></color>\uFF1A\u9009\u62E9\u5DE6\u4FA7\u5DE5\u5177\uFF0C\u518D<color=#914B2D><b>\u9009\u62E9\u6863\u4F4D</b></color>\uFF0C\u518D\u70B9\u51FB\u5730\u5757\uFF0C\u518D\u70B9\u51FB\u300C<color=#914B2D><b>\u5E94\u7528</b></color>\u300D\u3002\n\u8981\u53D6\u6D88\u5DF2\u6709\u5E72\u9884\uFF0C\u91CD\u65B0\u9009\u4E2D\u5BF9\u5E94\u5DE5\u5177\u4E0E\u5730\u5757\uFF0C\u70B9\u51FB\u300C<color=#914B2D><b>\u64A4\u9500</b></color>\u300D\u3002"
      illustration: {fileID: 0}
      sortOrder: 0
    - id: 3_2
      title: "\u8BA4\u8BC6\u4E94\u79CD\u5DE5\u5177"
      content: "\u5DE5\u5177 \xB7 \u7528\u9014\n<color=#2F6148><b>\u690D\u7269\u589E\u91CF</b></color>
        \xB7 \u8C03\u6574\u690D\u7269\u6BCF\u5929\u6062\u590D\u7684\u6570\u91CF\uFF0C\u5F71\u54CD<color=#2F6148><b>\u957F\u671F\u98DF\u7269\u4F9B\u5E94</b></color>\n<color=#2F6148><b>\u690D\u7269\u5B58\u91CF</b></color>
        \xB7 <color=#2F6148><b>\u7ACB\u5373\u589E\u52A0\u6216\u51CF\u5C11</b></color>\u5DF2\u6709\u690D\u7269\u8D44\u6E90\n<color=#2F6148><b>\u6E29\u5EA6</b></color>
        \xB7 \u8BA9\u5730\u5757\u9010\u6E10\u5347\u6E29\u6216\u964D\u6E29\n<color=#2F6148><b>\u6E7F\u5EA6</b></color>
        \xB7 \u8BA9\u5730\u5757\u9010\u6E10\u53D8\u6E7F\u6216\u53D8\u5E72\n<color=#2F6148><b>\u6D77\u62D4</b></color>
        \xB7 \u6539\u53D8\u5730\u5757\u9AD8\u5EA6\uFF0C\u5F71\u54CD\u5730\u8C8C\u4E0E<color=#2F6148><b>\u8FC1\u5F99\u901A\u9053</b></color>"
      mobileContent: "\u5DE5\u5177 \xB7 \u7528\u9014\n<color=#2F6148><b>\u690D\u7269\u589E\u91CF</b></color>
        \xB7 \u8C03\u6574\u690D\u7269\u6BCF\u5929\u6062\u590D\u7684\u6570\u91CF\uFF0C\u5F71\u54CD<color=#2F6148><b>\u957F\u671F\u98DF\u7269\u4F9B\u5E94</b></color>\n<color=#2F6148><b>\u690D\u7269\u5B58\u91CF</b></color>
        \xB7 <color=#2F6148><b>\u7ACB\u5373\u589E\u52A0\u6216\u51CF\u5C11</b></color>\u5DF2\u6709\u690D\u7269\u8D44\u6E90\n<color=#2F6148><b>\u6E29\u5EA6</b></color>
        \xB7 \u8BA9\u5730\u5757\u9010\u6E10\u5347\u6E29\u6216\u964D\u6E29\n<color=#2F6148><b>\u6E7F\u5EA6</b></color>
        \xB7 \u8BA9\u5730\u5757\u9010\u6E10\u53D8\u6E7F\u6216\u53D8\u5E72\n<color=#2F6148><b>\u6D77\u62D4</b></color>
        \xB7 \u6539\u53D8\u5730\u5757\u9AD8\u5EA6\uFF0C\u5F71\u54CD\u5730\u8C8C\u4E0E<color=#2F6148><b>\u8FC1\u5F99\u901A\u9053</b></color>"
      illustration: {fileID: 21300000, guid: e7c37cbe940642d2a4ad8ed0653f3bb6, type: 3}
      sortOrder: 1
    - id: 3_3
      title: "\u5DE5\u5177\u6863\u4F4D"
      content: "\u5DE5\u5177 \xB7 <color=#2F6148><b>\u5C0F\u5E45\u8C03\u6574</b></color>
        \xB7 <color=#2F6148><b>\u5927\u5E45\u8C03\u6574</b></color>\n<color=#2F6148><b>\u690D\u7269\u589E\u91CF</b></color>
        \xB7 <color=#914B2D><b>\xB125,000</b></color> / \u6E38\u620F\u65E5 \xB7 <color=#914B2D><b>\xB150,000</b></color>
        / \u6E38\u620F\u65E5\n<color=#2F6148><b>\u690D\u7269\u5B58\u91CF</b></color>
        \xB7 <color=#914B2D><b>\xB125%</b></color> \xB7 <color=#914B2D><b>\xB150%</b></color>\n<color=#2F6148><b>\u6E29\u5EA6</b></color>
