{
  "tutorialSeed": 1,
  "steps": [
    {
      "day": 0,
      "lesson": "新的星球",
      "text": "你来到了一个新的星球。这里一片荒芜，试着让<color=#C33A32>生命在这里延续</color>。",
      "unlocks": "",
      "completion": "continue",
      "pause": true,
      "lockSkip": false
    },
    {
      "day": 0,
      "lesson": "带来的鸽鸽",
      "text": "幸好，你不用从头开始。你从别的星球带来了一群<color=#C33A32>【鸽鸽】</color>。先看看新物种卡。",
      "unlocks": "",
      "completion": "startupCard",
      "pause": true,
      "lockSkip": true
    },
    {
      "day": 0,
      "lesson": "观察种群",
      "text": "鸽鸽头上的数字表示<color=#C33A32>种群数量</color>。随着日子过去，适应环境的种群可能会生长，不适应环境的种群可能会衰退。观察到第 6 天。",
      "unlocks": "",
      "completion": "day",
      "pause": false,
      "lockSkip": false
    },
    {
      "day": 6,
      "lesson": "查看鸽鸽",
      "text": "<color=#C33A32>按住 Alt 并左键点击鸽鸽</color>，查看种群信息。触屏设备可以直接点击种群。",
      "unlocks": "PopulationInfo",
      "completion": "selectPopulation",
      "pause": true,
      "lockSkip": true
    },
    {
      "day": 6,
      "lesson": "认识性状",
      "text": "生物有适温、适湿、运动、体型和繁殖五项重要性状。<color=#C33A32>红色雷达图</color>是原本的性状，绿色表示发生的变异。",
      "unlocks": "",
      "completion": "continue",
      "pause": true,
      "lockSkip": false
    },
    {
      "day": 6,
      "lesson": "查看环境",
      "text": "<color=#C33A32>按住 Alt 并左键点击地形</color>，查看环境信息。触屏设备可以直接点击地块。",
      "unlocks": "TileInfo",
      "completion": "selectTile",
      "pause": true,
      "lockSkip": true
    },
    {
      "day": 6,
      "lesson": "观察趋势",
      "text": "<color=#C33A32>折线图</color>显示当前种群和植物量的变化趋势。现在鸽鸽适应环境，数量正在上升。",
      "unlocks": "",
      "completion": "continue",
      "pause": true,
      "lockSkip": false
    },
    {
      "day": 7,
      "lesson": "变异与适应",
      "text": "只要环境不是过于恶劣，<color=#C33A32>变异</color>就可能让鸽鸽逐渐适应这里。希望它们能及时适应，让种群继续增长。",
      "unlocks": "",
      "completion": "continue",
      "pause": false,
      "lockSkip": false
    },
    {
      "day": 15,
      "lesson": "加快时间",
      "text": "可以点击右上角调节<color=#C33A32>倍速或暂停</color>。我们第 50 天见。",
      "unlocks": "Clock,FastClock",
      "completion": "day",
      "pause": false,
      "lockSkip": false
    },
    {
      "day": 50,
      "lesson": "稳定的种群",
      "text": "太好了，现在我们已经有一群<color=#C33A32>稳定的种群</color>！接下来试着让生态系统拥有更多动物。",
      "unlocks": "",
      "completion": "continue",
      "pause": true,
      "lockSkip": false
    },
    {
      "day": 50,
      "lesson": "打开进化网",
      "text": "<color=#C33A32>按 M 打开进化网</color>，看看鸽鸽可能进化成什么。",
      "unlocks": "SpeciesMap",
      "completion": "openMap",
      "pause": true,
      "lockSkip": true
    },
    {
      "day": 50,
      "lesson": "寻找彩鸡",
      "text": "点击<color=#C33A32>【彩鸡】头像</color>，查看它的性状和培育线索。",
      "unlocks": "",
      "completion": "colorClue",
      "pause": true,
      "lockSkip": true
    },
    {
      "day": 50,
      "lesson": "准备改造环境",
      "text": "<color=#C33A32>关闭进化网</color>。我们来改善环境，促成【彩鸡】进化。",
      "unlocks": "",
      "completion": "closeMap",
      "pause": true,
      "lockSkip": true
    },
    {
      "day": 50,
      "lesson": "提高温度",
      "text": "彩鸡喜欢炎热的环境。打开<color=#C33A32>温度工具</color>，选择<color=#C33A32>提高一档</color>，选中鸽鸽所在的地块并应用。",
      "unlocks": "EnvironmentPreview,Temperature",
      "completion": "temperature",
      "pause": true,
      "lockSkip": true
    },
    {
      "day": 50,
      "lesson": "观察工具效果",
      "text": "温度会<color=#C33A32>缓慢提升</color>，维持一段时间，然后逐渐恢复。期间可以点击鸽鸽，查看它们的适应情况。",
      "unlocks": "",
      "completion": "continue",
      "pause": true,
      "lockSkip": false
    },
    {
      "day": 50,
      "temperatureAtLeast": 70,
      "lesson": "控制温度",
      "text": "地块温度已达到 <color=#C33A32>70 度</color>，时间已暂停。不要升得过高，可以在温度工具中选择撤销，让它开始恢复。",
      "unlocks": "CancelTool",
      "completion": "continue",
      "pause": true,
      "lockSkip": false
    },
    {
      "day": 50,
      "lesson": "再看进化网",
      "text": "再<color=#C33A32>按 M 打开进化网</color>，查看鸽鸽与彩鸡的性状差距。",
      "unlocks": "",
      "completion": "openMap",
      "pause": true,
      "lockSkip": true
    },
    {
      "day": 50,
      "lesson": "彩鸡目标",
      "text": "点击<color=#C33A32>彩鸡头像</color>查看线索：体型约 14、繁殖能力约 75、适湿约 49。具体进化条件还要结合生态环境观察。",
      "unlocks": "",
      "completion": "colorClue",
      "pause": true,
      "lockSkip": true
    },
    {
      "day": 50,
      "lesson": "回到星球",
      "text": "<color=#C33A32>关闭进化网</color>，继续改造鸽鸽生活的环境。",
      "unlocks": "",
      "completion": "closeMap",
      "pause": true,
      "lockSkip": true
    },
    {
      "day": 50,
      "lesson": "自主培育",
      "text": "湿度、植物日增量和植物存量工具也已开放。注意<color=#C33A32>释放与撤销的时机</color>；善用进化网、种群和地块信息，引导彩鸡进化。",
      "unlocks": "Humidity,PlantRecovery,PlantStock,AllToolTiers",
      "completion": "continue",
      "pause": true,
      "lockSkip": false
    },
    {
      "day": 50,
      "lesson": "等待彩鸡诞生",
      "text": "现在你已掌握主要操作。继续改造环境并观察鸽鸽的性状，直到<color=#C33A32>彩鸡真正出现</color>。地图上已有地块时，可以按 N 在旁边建造；相邻地块可能影响迁徙和运动能力。",
      "unlocks": "",
      "completion": "colorUnlocked",
      "pause": false,
      "lockSkip": false
    },
    {
      "day": 50,
      "lesson": "彩鸡诞生",
      "text": "<color=#C33A32>彩鸡诞生了</color>！你完成了从观察种群、改善环境到物种演化的一次完整循环。继续培育更多物种吧！",
      "unlocks": "Advanced",
      "completion": "continue",
      "pause": true,
      "lockSkip": false
    }
  ]
}
